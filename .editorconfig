# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# ktlint (Spotless): estilo de Android Studio. Las funciones @Composable van en PascalCase.
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,json,yml,yaml,js,mjs,cjs,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

# Generados: no se tocan a mano
[{app/src/main/assets/**,dominio/src/test/resources/referencia/**,datos/schemas/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
